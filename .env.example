# Core Discord configuration (required)
SLURPY_TOKEN=
GENERAL_ID=

# Feature-specific Discord channels (required only for that feature)
CHAI_ID=
FANTASY_ID=

# Blackjack persistence
DATABASE_URL=

# Optional integrations
OPENAI_API_KEY=
CHAI_API=
WEATHER_API=
FORTNITE_API=
GIPHY_KEY=

# Yahoo Fantasy is temporarily disabled by default. Do not enable this until
# Yahoo API access is restored and the integration has been verified.
FANTASY_ENABLED=false
ACCESS_TOKEN=
CONSUMER_KEY=
CONSUMER_SECRET=
REFRESH_TOKEN=
TOKEN_TIME=
TOKEN_TYPE=
LEAGUE_ID=

# Render supplies PORT automatically for a web service.
PORT=8080

# Logging
LOG_LEVEL=INFO
